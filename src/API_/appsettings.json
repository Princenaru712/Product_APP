        "Sqlcon": "Server=localhost,1999;Database=CRN_DATABASE_NEW;User Id=sa;Password=Pass@123;TrustServerCertificate=True;Encrypt=False"
    },
    "Jwt": {
        "Key": "SuperSecretKeyLongerThanThirtyTwoBytes",
        "Issuer": "ProductApiIssuer",
        "Audience": "ProductApiAudience",
